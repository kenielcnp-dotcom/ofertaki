{
  "expo": {
    "name": "Ofertaki",
    "slug": "ofertaki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ofertaki.app"
    },
    "android": {
      "package": "com.ofertaki.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A5331",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Ofertaki usa suas fotos para anexar imagens às promoções que você publicar.",
          "cameraPermission": "O Ofertaki usa a câmera para você fotografar promoções na hora de publicar."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c4ad1e76-89b1-4cda-b7be-73597d5e3d1e"
      }
    },
    "owner": "kenieldotcoms-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c4ad1e76-89b1-4cda-b7be-73597d5e3d1e"
    }
  }
}
